# Public site URL (used for OAuth redirects and canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only service role key for background webhook handlers (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WhatsApp Cloud API & Webhook Configuration
WHATSAPP_APP_SECRET=your-whatsapp-app-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-whatsapp-webhook-verify-token
WHATSAPP_API_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_TEMPLATE_NAME=order_confirmation
WHATSAPP_TEMPLATE_LANG=ar
WHATSAPP_MOCK_MODE=false

# Client-side payment destination handles (optional)
NEXT_PUBLIC_INSTAPAY_HANDLE=
NEXT_PUBLIC_VODAFONE_CASH_NUMBER=


