    {
      "name": "8a. Attempt to update another customer's profile (Next.js Endpoint)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 403 Forbidden', function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Forbidden error returned', function () {",
              "    pm.expect(jsonData.success).to.be.false;",
              "    pm.expect(jsonData.error).to.include('Forbidden');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"MaliciousName\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/profile/{{targetUserId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "profile",
            "{{targetUserId}}"
          ]
        },
        "description": "Verifies application-layer security: A regular customer attempting to update a profile whose ID differs from their own receives 403 Forbidden."
      }
    },
    {
      "name": "8b. Attempt to update another customer's profile (Direct Supabase RLS)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK (with 0 rows updated)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('PostgreSQL RLS blocks update, returning empty array', function () {",
              "    pm.expect(jsonData).to.be.an('array');",
              "    pm.expect(jsonData.length).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "apikey",
            "value": "{{supabaseAnonKey}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Prefer",
            "value": "return=representation"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"DirectRLSBypassAttempt\"\n}"
        },
        "url": {
          "raw": "{{supabaseUrl}}/rest/v1/profiles?id=eq.{{targetUserId}}",
          "host": [
            "{{supabaseUrl}}"
          ],
          "path": [
            "rest",
            "v1",
            "profiles"
          ],
          "query": [
            {
              "key": "id",
              "value": "eq.{{targetUserId}}"
            }
          ]
        },
        "description": "Direct Supabase REST test: verifies that even if an attacker bypasses the Next.js API, PostgreSQL RLS policy 'Update own profile' (id = auth.uid()) silences the update, affecting 0 rows."
      }
    },
