              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Tokens returned and saved to environment', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data.session).to.have.property('access_token');",
              "    pm.environment.set('accessToken', jsonData.data.session.access_token);",
              "    pm.environment.set('refreshToken', jsonData.data.session.refresh_token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
