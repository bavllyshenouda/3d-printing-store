  "item": [
    {
      "name": "1. Register a new customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Registration successful response format', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.have.property('user');",
              "});",
              "if (jsonData.data && jsonData.data.session && jsonData.data.session.access_token) {",
              "    pm.environment.set('accessToken', jsonData.data.session.access_token);",
              "    pm.environment.set('refreshToken', jsonData.data.session.refresh_token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer-{{$timestamp}}@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"first_name\": \"Ahmed\",\n  \"last_name\": \"Hassan\",\n  \"phone\": \"01012345678\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Registers a new customer with valid email, password, first name, last name, and an Egyptian phone number (010, 011, 012, or 015, exactly 11 digits)."
      }
    },
    {
      "name": "2. Register with invalid input (Invalid Phone & Short Password)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Validation failure details returned', function () {",
              "    pm.expect(jsonData.success).to.be.false;",
              "    pm.expect(jsonData.error).to.eql('Validation failed');",
              "    pm.expect(jsonData.details).to.have.property('phone');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"invalid-phone@example.com\",\n  \"password\": \"123\",\n  \"first_name\": \"Ahmed\",\n  \"last_name\": \"Hassan\",\n  \"phone\": \"01312345678\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Attempts registration with an invalid phone prefix (013 is not an Egyptian mobile prefix) and a password less than 6 characters. Must return 400."
      }
    },
    {
      "name": "3. Log in with valid credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
