  "item": [
    {
      "name": "1. Retrieve product categories",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Categories array returned', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.have.property('categories');",
              "    pm.expect(jsonData.data.categories).to.be.an('array');",
              "});",
              "if (jsonData.data.categories.length > 0) {",
              "    pm.environment.set('categoryId', jsonData.data.categories[0].id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": ["{{baseUrl}}"],
          "path": ["api", "categories"]
        },
        "description": "Public endpoint: Retrieves active categories ordered by sort_order and name."
      }
    },
