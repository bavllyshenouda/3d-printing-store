        "url": {
          "raw": "{{baseUrl}}/api/cart",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cart"]
        },
        "description": "Attempts to add a nonexistent product UUID to cart. Returns 404."
      }
    },
