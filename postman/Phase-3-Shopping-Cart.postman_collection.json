  "item": [
    {
      "name": "1. Retrieve an empty cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Cart structure returned correctly', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.have.property('items');",
              "    pm.expect(jsonData.data).to.have.property('summary');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cart",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cart"]
        },
        "description": "Retrieves the authenticated customer's cart. Returns empty array if no items added."
      }
    },
    {
      "name": "2. Add a valid product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created or 200 OK', function () {",
              "    pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Product added to cart with authoritative pricing', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data.item).to.have.property('id');",
              "    pm.expect(jsonData.data).to.have.property('authoritative_unit_price');",
              "    pm.environment.set('cartItemId', jsonData.data.item.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerAccessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": \"{{productId}}\",\n  \"color\": \"Emerald Green\",\n  \"quantity\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/cart",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cart"]
        },
        "description": "Adds a published product with a valid color and quantity. Auto-saves cartItemId."
      }
    },
    {
      "name": "3. Add the same product again (Duplicate Prevention & Quantity Increment)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Quantity incremented without creating duplicate row', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.message).to.eql('Cart item quantity updated');",
              "    pm.expect(jsonData.data.item.quantity).to.be.above(2);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerAccessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": \"{{productId}}\",\n  \"color\": \"Emerald Green\",\n  \"quantity\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/cart",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cart"]
        },
        "description": "Demonstrates duplicate prevention: Adding the same product and color increments the existing item quantity instead of violating UNIQUE(user_id, product_id, color)."
      }
    },
    {
      "name": "4. Update item quantity",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Quantity updated and line total recalculated', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data.item.quantity).to.eql(4);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerAccessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 4\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/cart/{{cartItemId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cart", "{{cartItemId}}"]
        },
        "description": "Updates the quantity of an existing cart item within inventory limits."
      }
    },
    {
