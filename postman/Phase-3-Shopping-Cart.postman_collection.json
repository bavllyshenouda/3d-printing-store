      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Item removed successfully', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.message).to.eql('Cart item removed successfully');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cart/{{cartItemId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cart", "{{cartItemId}}"]
        },
        "description": "Removes a specific item from the customer's cart."
      }
    },
    {
      "name": "6a. Attempt to access another user's cart (Next.js Endpoint)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 404 Not Found', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Foreign cart item access denied and concealed', function () {",
              "    pm.expect(jsonData.success).to.be.false;",
              "    pm.expect(jsonData.error).to.include('not found');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerAccessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 99\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/cart/00000000-0000-0000-0000-000000000000",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cart", "00000000-0000-0000-0000-000000000000"]
        },
        "description": "Security test: Attempting to modify another customer's cart item ID is rejected with 404 Not Found."
      }
    },
    {
      "name": "6b. Attempt to access another user's cart (Direct Supabase RLS)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK (with 0 foreign rows)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('PostgreSQL RLS blocks reading foreign cart items', function () {",
              "    pm.expect(jsonData).to.be.an('array');",
              "    pm.expect(jsonData.length).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "apikey",
            "value": "{{supabaseAnonKey}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{supabaseUrl}}/rest/v1/cart_items?user_id=eq.{{otherUserId}}",
          "host": ["{{supabaseUrl}}"],
          "path": ["rest", "v1", "cart_items"],
          "query": [
            {
              "key": "user_id",
              "value": "eq.{{otherUserId}}"
            }
          ]
        },
        "description": "Direct Supabase REST test: RLS policy 'Customers manage own cart' (user_id = auth.uid()) silences foreign cart reads, returning empty array []."
      }
    },
