        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": \"{{productId}}\",\n  \"color\": \"Emerald Green\",\n  \"quantity\": 99999\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/cart",
