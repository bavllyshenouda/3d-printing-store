        "url": {
          "raw": "{{baseUrl}}/api/cart",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cart"]
        },
        "description": "Attempts to add a deactivated/draft product to cart. Returns 400 Bad Request."
      }
    },
