          "path": ["api", "cart"]
        },
        "description": "Sends request to cart endpoints without authentication header or cookie. Must return 401 Unauthorized."
      }
    },
    {
      "name": "12. Verify client-submitted prices cannot control pricing",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 or 201', function () {",
              "    pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Client price of 0.01 was ignored in favor of DB price', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data.authoritative_unit_price).to.be.above(1.00);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerAccessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": \"{{productId}}\",\n  \"color\": \"Emerald Green\",\n  \"quantity\": 1,\n  \"price\": 0.01,\n  \"line_total\": 0.01\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/cart",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cart"]
        },
        "description": "Price tamper test: Submits a malicious price: 0.01. The server discards it and calculates authoritative totals directly from the database."
      }
