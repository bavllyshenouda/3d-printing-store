              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Error reports product not found', function () {",
              "    pm.expect(jsonData.success).to.be.false;",
              "    pm.expect(jsonData.error).to.eql('Product not found');",
              "});"
            ]
          }
        }
