          "raw": "{{baseUrl}}/api/orders/{{orderId}}/cancel",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders", "{{orderId}}", "cancel"]
        },
        "description": "Customer cancels order before shipping. The cancel_order_and_restore_stock RPC restores stock to products table."
      }
    },
