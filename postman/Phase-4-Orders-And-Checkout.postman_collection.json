    {
      "name": "14. Test checkout with Prepaid payment method (InstaPay / Vodafone Cash)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Prepaid checkout preserves pending verification status', function () {",
              "    if (pm.response.code === 201) {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData.data.order.payment_method).to.eql('instapay');",
              "        pm.expect(jsonData.data.order.payment_status).to.eql('pending');",
              "        pm.expect(jsonData.data.order.status).to.eql('pending_customer_confirmation');",
              "    }",
              "});"
