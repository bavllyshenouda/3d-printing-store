          "raw": "{{baseUrl}}/api/admin/orders/{{orderId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "orders", "{{orderId}}"]
        },
        "description": "Administrator securely updates order status, verifies payment, assigns carrier tracking, and writes shipping events."
