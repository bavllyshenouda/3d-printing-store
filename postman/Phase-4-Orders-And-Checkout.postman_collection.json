{
  "info": {
    "_postman_id": "a984fd31-419b-4654-9a25-c651e70e93a1",
    "name": "3D Printing Store - Phase 4 Orders and Checkout",
    "description": "Comprehensive Postman test collection for Phase 4: Orders, Atomic Checkout RPC, Inventory Concurrency, Price Authority, State Transitions, and RLS Isolation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
