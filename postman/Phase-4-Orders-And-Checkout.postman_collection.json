        "body": {
          "mode": "raw",
          "raw": "{\n  \"address_id\": \"{{addressId}}\",\n  \"payment_method\": \"instapay\",\n  \"shipping_fee\": 50\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/checkout",
          "host": ["{{baseUrl}}"],
          "path": ["api", "checkout"]
        },
        "description": "Verifies that prepaid payment methods (InstaPay, Vodafone Cash) remain in pending payment status and require verification."
