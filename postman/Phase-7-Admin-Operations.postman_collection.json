{
  "info": {
    "_postman_id": "c841aa91-381f-4b02-8611-d1f5e2786910",
    "name": "3D Printing Store - Phase 7 Admin Operations",
    "description": "Comprehensive Postman test collection for Phase 7: Catalog administration, Order lifecycle management, Payment proof review, Custom quote management, and Sanitized customer profiles with strict administrative access control.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Unauthenticated access to admin endpoints rejected (HTTP 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 401 Unauthorized', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Error indicates authentication is required', function () {",
              "    pm.expect(jsonData.success).to.be.false;",
              "    pm.expect(jsonData.error).to.include('Authentication required');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/admin/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "products"]
        },
        "description": "Ensures requests lacking authentication credentials receive HTTP 401."
      }
    },
    {
      "name": "2. Non-admin customer access to admin endpoints rejected (HTTP 403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 403 Forbidden', function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Error indicates administrator privileges required', function () {",
              "    pm.expect(jsonData.success).to.be.false;",
              "    pm.expect(jsonData.error).to.include('Administrator privileges required');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "products"]
        },
        "description": "Ensures normal customer accounts without admin role in public.admins receive HTTP 403."
      }
    },
    {
      "name": "3. Admin lists products including unpublished and deactivated items",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Products returned with pagination metadata', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "    pm.expect(jsonData.pagination).to.have.property('total');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/products?include_inactive=true&page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "products"],
          "query": [
            { "key": "include_inactive", "value": "true" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        },
        "description": "Returns full product catalog including drafts and inactive items for administrators."
      }
    },
    {
      "name": "4. Admin creates new product with stock and specifications",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Product created with draft status and stock', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.have.property('id');",
              "    pm.expect(jsonData.data.stock_quantity).to.eql(25);",
              "    pm.expect(jsonData.data.is_published).to.be.false;",
              "    pm.environment.set('adminProductId', jsonData.data.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Precision Calibration Cube 20mm\",\n  \"slug\": \"precision-calibration-cube-20mm\",\n  \"description\": \"Standard 20mm calibration cube for testing dimensional accuracy and extrusion.\",\n  \"price\": 85.00,\n  \"stock_quantity\": 25,\n  \"is_published\": false,\n  \"is_active\": true,\n  \"available_colors\": [\"Black\", \"White\", \"Silver\", \"Neon Green\"],\n  \"dimensions\": {\"x\": 20, \"y\": 20, \"z\": 20, \"unit\": \"mm\"},\n  \"material\": \"PLA+\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "products"]
        },
        "description": "Creates a new product record in draft state."
      }
    },
    {
      "name": "5. Admin updates product details and stock quantity",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Product updated with modified price and stock', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data.price).to.eql(95);",
              "    pm.expect(jsonData.data.stock_quantity).to.eql(30);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 95.00,\n  \"stock_quantity\": 30\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/products/{{adminProductId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "products", "{{adminProductId}}"]
        },
        "description": "Updates price and stock for an existing product."
      }
    },
    {
      "name": "6. Admin publishes product to make it customer-visible",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Product publication state is true', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data.is_published).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_published\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/products/{{adminProductId}}/publish",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "products", "{{adminProductId}}", "publish"]
        },
        "description": "Toggles product publish status to live."
      }
    },
    {
      "name": "7. Admin attaches image metadata to product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Image metadata record added', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.have.property('id');",
              "    pm.expect(jsonData.data.is_primary).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"image_url\": \"https://example-bucket.supabase.co/storage/v1/object/public/product-images/cube-front.jpg\",\n  \"is_primary\": true,\n  \"display_order\": 0,\n  \"alt_text\": \"Calibration Cube Isometric View\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/products/{{adminProductId}}/images",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "products", "{{adminProductId}}", "images"]
        },
        "description": "Attaches an image reference to the product."
      }
    },
    {
      "name": "8. Admin creates a new category",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created or 200 OK', function () {",
              "    pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Category created with slug', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.have.property('id');",
              "    pm.environment.set('adminCategoryId', jsonData.data.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
