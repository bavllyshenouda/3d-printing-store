          "raw": "{\n  \"name\": \"Calibration & Test Models\",\n  \"slug\": \"calibration-test-models\",\n  \"description\": \"Dimensional test prints, tolerance gauges, and benchy models.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/categories",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "categories"]
