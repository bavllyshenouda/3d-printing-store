    {
      "name": "10. Admin updates order status and logs shipping event",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Order status transitioned to processing', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data.status).to.eql('processing');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"processing\",\n  \"notes\": \"Models sliced and sent to Bambu Lab X1-Carbon print farm.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/orders/{{orderId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "orders", "{{orderId}}"]
        },
        "description": "Transitions order through valid state machine path and logs a shipping/audit event."
      }
    },
    {
      "name": "11. Admin lists payments awaiting review and generates signed proof preview",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Pending payment proofs include signed download URLs', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "    if (jsonData.data.length > 0) {",
              "        pm.expect(jsonData.data[0]).to.have.property('proof_signed_url');",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/payments?status=awaiting_review",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "payments"],
          "query": [
            { "key": "status", "value": "awaiting_review" }
          ]
        },
        "description": "Retrieves offline payment proofs with secure time-limited signed URLs."
      }
    },
    {
      "name": "12. Admin reviews and approves payment proof",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Payment status approved and order synchronized', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data.status).to.eql('approved');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"approve\",\n  \"notes\": \"InstaPay transfer reference matches bank statement.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/payments/{{paymentId}}/review",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "payments", "{{paymentId}}", "review"]
        },
        "description": "Approves customer payment proof, marking order payment_status as paid."
      }
    },
    {
      "name": "13. Admin queries sanitized customer profiles without exposing credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Customer list contains sanitized profiles and order aggregates', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "    if (jsonData.data.length > 0) {",
              "        var customer = jsonData.data[0];",
              "        pm.expect(customer).to.have.property('id');",
              "        pm.expect(customer).to.have.property('email');",
              "        pm.expect(customer).to.have.property('order_count');",
              "        pm.expect(customer).to.have.property('total_spent');",
              "        pm.expect(customer).to.not.have.property('encrypted_password');",
              "        pm.expect(customer).to.not.have.property('password_hash');",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/customers?page=1&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "customers"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "20" }
          ]
        },
        "description": "Lists customer accounts with purchase metrics while strictly protecting auth secrets."
      }
    }
