              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Deduplication recognizes already processed message ID', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.results[0].status).to.eql('already_processed');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
