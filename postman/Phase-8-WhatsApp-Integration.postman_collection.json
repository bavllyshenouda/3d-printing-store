        },
        "description": "Verifies duplicate inbound webhooks with identical provider_message_id are safely ignored."
      }
    },
    {
      "name": "11. Inbound Ambiguous Order Handling (Multiple Orders Without Explicit Order Number)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Ambiguous reply handled safely without guessing', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(['ambiguous_orders', 'no_matching_order']).to.include(jsonData.results[0].status);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-hub-signature-256",
            "value": "sha256=mock_valid_signature"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"wh_acc_123\",\n      \"changes\": [\n        {\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": {\n              \"display_phone_number\": \"201000000000\",\n              \"phone_number_id\": \"test_phone_id\"\n            },\n            \"messages\": [\n              {\n                \"from\": \"201099999999\",\n                \"id\": \"wamid.inbound_ambiguous_003\",\n                \"timestamp\": \"1730174420\",\n                \"type\": \"text\",\n                \"text\": {\n                  \"body\": \"CONFIRM\"\n                }\n              }\n            ]\n          },\n          \"field\": \"messages\"\n        }\n      ]\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/webhooks/whatsapp",
          "host": ["{{baseUrl}}"],
          "path": ["api", "webhooks", "whatsapp"]
        },
        "description": "Tests handling when customer replies without order reference while having multiple active orders."
      }
    },
    {
      "name": "12. Admin Inspects WhatsApp Audit Log",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Audit log contains inbound and outbound message entries', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.messages).to.be.an('array');",
              "    pm.expect(jsonData.pagination).to.have.property('total');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/whatsapp?order_id={{orderId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "whatsapp"],
          "query": [
            { "key": "order_id", "value": "{{orderId}}" }
          ]
        },
        "description": "Queries whatsapp_messages table for complete audit trail of order communications."
      }
    }
